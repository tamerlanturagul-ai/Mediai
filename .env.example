# MediAI — environment template (TASK-010).
# Copy to .env for local dev. NEVER commit real keys (.env is git-ignored).

# Comma-separated CORS whitelist. Empty/unset -> local-only default
# ["http://localhost:8000","http://127.0.0.1:8000"].
CORS_ORIGINS="https://app.example.com,https://example.com"

# Comma-separated API keys for X-API-Key auth on /api/* (except /api/health).
# Empty/unset -> auth DISABLED (local dev + tests). Production MUST set this.
API_KEYS=""

# Photo retention in days (TASK-012). Uploaded photos (+ sidecar JSON) expire
# and are auto-deleted after this TTL (startup + per-upload sweep).
# Default 30, clamped to 1..365.
PHOTO_TTL_DAYS="30"
